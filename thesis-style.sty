\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thesis-style}[2026/04/25 Computer Science honors thesis style]

% --- Packages (load order: biblatex before hyperref; cleveref after hyperref) ---
\RequirePackage[letterpaper]{geometry}
\RequirePackage{setspace}
\RequirePackage{libertinus}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{libertinust1math}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{csquotes}
\RequirePackage[
  style=authoryear,
  maxbibnames=10,
  maxcitenames=2,
  uniquename=false,
  language=american,
  natbib=true
]{biblatex}
\addbibresource{references/references.bib}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage[nameinlink,noabbrev]{cleveref}

% --- Page body and paragraph spacing ---
\setstretch{1}
\setlength{\parindent}{0.5in}
\setlength{\parskip}{0pt}
\setlength{\oddsidemargin}{36.1pt}
\setlength{\evensidemargin}{36.1pt}
\setlength{\marginparwidth}{40pt}
\setlength{\marginparsep}{10pt}
\setlength{\topmargin}{0pt}
\setlength{\headsep}{0.5in}
\setlength{\textheight}{8.1in}
\setlength{\textwidth}{6in}
\brokenpenalty=10000

\pagestyle{headings}

% --- Code listings ---
\definecolor{codebackground}{RGB}{248,248,248}
\definecolor{codecomment}{RGB}{80,120,80}
\definecolor{codekeyword}{RGB}{40,80,160}

\lstdefinestyle{thesiscode}{
  backgroundcolor=\color{codebackground},
  basicstyle=\ttfamily\small,
  breaklines=true,
  commentstyle=\color{codecomment},
  keywordstyle=\color{codekeyword}\bfseries,
  numbers=left,
  numberstyle=\tiny,
  showstringspaces=false,
  tabsize=2
}
\lstset{style=thesiscode}

% --- Theorems ---
\newtheorem{theorem}{Theorem}[chapter]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{definition}[theorem]{Definition}

\makeatletter

% --- Thesis metadata (set values in first_last_thesis.tex) ---
\newcommand{\thesistitle}[1]{\def\@thesistitle{#1}}
\newcommand{\thesisauthor}[1]{\def\@thesisauthor{#1}}
\newcommand{\thesisinstitution}[1]{\def\@thesisinstitution{#1}}
\newcommand{\thesisdepartment}[1]{\def\@thesisdepartment{#1}}
\newcommand{\thesisdegree}[1]{\def\@thesisdegree{#1}}
\newcommand{\thesisdate}[1]{\def\@thesisdate{#1}}
\newcommand{\dedication}[1]{\def\@thesisdedication{#1}}

% --- Prior-publication citation page ---
\newcommand{\citationheadingpublished}{%
  Material from this thesis has been published in the following form:\par
  \vspace{2em}%
}

\newcommand{\citationheadingaccepted}[2]{%
  Material from this thesis was accepted for publication in #1 on #2 in the
  following form:\par
  \vspace{2em}%
}

\newcommand{\citationheadingsubmitted}[2]{%
  Material from this thesis was submitted for publication to #1 on #2 in the
  following form:\par
  \vspace{2em}%
}

\newenvironment{citations}{%
  \chapter*{Citations}%
  \addcontentsline{toc}{chapter}{Citations}%
  \begingroup
  \singlespacing
}{%
  \endgroup
  \clearpage
}

% Add committee members by repeating \advisor and \reader in the preamble.
\newcount\thesis@advisorcount
\newcount\thesis@readercount

\newcommand{\advisor}[3]{%
  \ifnum\thesis@advisorcount<3
    \global\advance\thesis@advisorcount\@ne
    \ifcase\thesis@advisorcount\relax
    \or \gdef\thesis@advisor@one{\thesis@committeeperson{#1}{#2}{#3}}%
    \or \gdef\thesis@advisor@two{\thesis@committeeperson{#1}{#2}{#3}}%
    \or \gdef\thesis@advisor@three{\thesis@committeeperson{#1}{#2}{#3}}%
    \fi
  \else
    \PackageError{thesis-style}{At most three advisors are supported}%
      {Remove an \string\advisor\space command from the thesis preamble.}%
  \fi
}

\newcommand{\reader}[3]{%
  \ifnum\thesis@readercount<3
    \global\advance\thesis@readercount\@ne
    \ifcase\thesis@readercount\relax
    \or \gdef\thesis@reader@one{\thesis@committeeperson{#1}{#2}{#3}}%
    \or \gdef\thesis@reader@two{\thesis@committeeperson{#1}{#2}{#3}}%
    \or \gdef\thesis@reader@three{\thesis@committeeperson{#1}{#2}{#3}}%
    \fi
  \else
    \PackageError{thesis-style}{At most three readers are supported}%
      {Remove a \string\reader\space command from the thesis preamble.}%
  \fi
}

\thesistitle{Thesis Title}
\thesisauthor{Author Name}
\thesisinstitution{Institution Name}
\thesisdepartment{Department Name}
\thesisdegree{Degree Name}
\thesisdate{\today}
\dedication{}

\let\thesis@frontmatter\frontmatter
\renewcommand{\frontmatter}{%
  \thesis@frontmatter
  \pagestyle{plain}%
}

\let\thesis@mainmatter\mainmatter
\renewcommand{\mainmatter}{%
  \thesis@mainmatter
  \pagestyle{headings}%
}

% --- Chapter and frontmatter headings ---
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{50\p@}%
  {\parindent\z@ \raggedright \normalfont
    \ifnum \c@secnumdepth>\m@ne
      \if@mainmatter
        {\huge\bfseries\scshape \@chapapp\space\thechapter\par\nobreak}%
        \vskip 20\p@
      \fi
    \fi
    \interlinepenalty\@M
    {\Huge\bfseries\scshape #1\par\nobreak}%
    \vskip 40\p@
  }%
}

\renewcommand{\@makeschapterhead}[1]{%
  \vspace*{50\p@}%
  {\parindent\z@ \raggedright \normalfont
    \interlinepenalty\@M
    {\Huge\bfseries\scshape #1\par\nobreak}%
    \vskip 40\p@
  }%
}

% --- Title page ---
\newcommand{\makethesistitle}{%
  \hypersetup{pageanchor=false}%
  \begin{titlepage}
    \thispagestyle{empty}
    \null\vskip1in
    \begin{center}
      {\LARGE\scshape \@thesistitle\par}
    \end{center}
    \vfill
    \begin{center}
      \large
      AN UNDERGRADUATE HONORS THESIS\\
      SUBMITTED TO THE\\
      \MakeUppercase{\@thesisdepartment}\\
      AT \MakeUppercase{\@thesisinstitution}\\
      IN PARTIAL FULFILLMENT OF THE REQUIREMENTS\\
      FOR THE DEGREE OF\\
      \MakeUppercase{\@thesisdegree}
    \end{center}
    \vfill
    \begin{center}
      {\rmfamily\textsc{\@thesisauthor}}\\
      \@thesisdate
    \end{center}
    \vskip.5in
  \end{titlepage}
  \clearpage
  \hypersetup{pageanchor=true}%
  \pagenumbering{roman}%
  \pagestyle{plain}%
  \makethesiscommittee
  \makethesisdedication
}

% --- Committee page ---
\newcommand{\thesis@committeeperson}[3]{%
  {\large #1\par}%
  \vspace{0.08in}%
  {\normalsize\itshape #2\par}%
  \vspace{0.06in}%
  {\normalsize #3\par}%
}

\newcommand{\thesis@committeeentry}[2]{%
  \begin{minipage}[t]{#1}
    \centering
    #2
  \end{minipage}%
}

\newcommand{\thesis@committeegrid}[2]{%
  \ifcase#1\relax
  \or
    \noindent\makebox[\textwidth][c]{%
      \thesis@committeeentry{0.58\textwidth}{\csname thesis@#2@one\endcsname}%
    }\par
  \or
    \noindent
    \thesis@committeeentry{0.44\textwidth}{\csname thesis@#2@one\endcsname}%
    \hfill
    \thesis@committeeentry{0.44\textwidth}{\csname thesis@#2@two\endcsname}%
    \par
  \or
    \noindent
    \thesis@committeeentry{0.30\textwidth}{\csname thesis@#2@one\endcsname}%
    \hfill
    \thesis@committeeentry{0.30\textwidth}{\csname thesis@#2@two\endcsname}%
    \hfill
    \thesis@committeeentry{0.30\textwidth}{\csname thesis@#2@three\endcsname}%
    \par
  \fi
}

\newcommand{\makethesiscommittee}{%
  \ifnum\thesis@advisorcount<1
    \PackageError{thesis-style}{No thesis advisor was specified}%
      {Add at least one \string\advisor\string{Name\string}\string{Title\string}\string{Affiliation\string}\space command.}%
  \fi
  \ifnum\thesis@readercount<1
    \PackageError{thesis-style}{No thesis reader was specified}%
      {Add at least one \string\reader\string{Name\string}\string{Title\string}\string{Affiliation\string}\space command.}%
  \fi
  \hypersetup{pageanchor=false}%
  \thispagestyle{empty}%
  \begingroup
  \setlength{\parindent}{0pt}%
  \begin{center}
    \vspace*{0.75in}%
    {\LARGE\bfseries\scshape Thesis Committee\par}
    \vspace{1.0in}%
    {\large\scshape
      \ifnum\thesis@advisorcount=1 Advisor\else Co-Advisors\fi
      \par}
    \vspace{0.32in}%
  \end{center}
  \thesis@committeegrid{\the\thesis@advisorcount}{advisor}%
  \begin{center}
    \vspace{0.8in}%
    \rule{2.6in}{0.4pt}\par
    \vspace{0.6in}%
    {\large\scshape
      \ifnum\thesis@readercount=1 Reader\else Readers\fi
      \par}
    \vspace{0.32in}%
  \end{center}
  \thesis@committeegrid{\the\thesis@readercount}{reader}%
  \endgroup
  \clearpage
  \hypersetup{pageanchor=true}%
}

% --- Dedication page ---
\newcommand{\makethesisdedication}{%
  \ifx\@thesisdedication\@empty
  \else
    \hypersetup{pageanchor=false}%
    \thispagestyle{empty}%
    \vspace*{1.5in}%
    \noindent\begin{minipage}{\textwidth}
      \raggedright\noindent{\textit{\@thesisdedication}}
    \end{minipage}%
    \clearpage
  \fi
  \setcounter{page}{1}%
  \hypersetup{pageanchor=true}%
}

\makeatother
